        <mxCell id="person_developer_label" value="&lt;b&gt;Connector Maintainer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;[Person]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666666&quot;&gt;Bumps package.json and runs the release-prep command locally.&lt;/font&gt;" style="text;html=1;fontSize=12;align=center;verticalAlign=top;" vertex="1" parent="1">
